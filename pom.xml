<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.expensetracker</groupId>
	<artifactId>expensetracker</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>expensetracker</name>
	<description>Expense tracking API with JWT-based authentication</description>

	<properties>
		<java.version>26</java.version>
	</properties>

	<!--
	    dependencyManagement pins versions for BOMs (bill of materials) that aren't
	    already managed by the spring-boot-starter-parent above. Declaring it here
	    means the actual <dependency> entries below don't need explicit <version>
	    tags for anything covered by these BOMs.
	-->
	<dependencyManagement>
		<dependencies>
			<!--
			    Testcontainers BOM. Pinned explicitly (rather than left to Spring's
			    managed version) because CVE-2024-25710 and CVE-2024-26308 — both in
			    the transitively-pulled commons-compress — affect 1.20.x. 1.21.4 is
			    the latest 1.x release with the fix, without the artifact-ID renames
			    that shipped in Testcontainers 2.0.
			-->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>1.21.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<!-- ================= CORE APPLICATION ================= -->

		<!-- Spring MVC (REST controllers), embedded Tomcat, Jackson 3 JSON support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Spring Data JPA: repositories, Hibernate ORM, entity mapping -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Bean Validation (jakarta.validation) — @NotNull, @Valid on request DTOs -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC driver — used at runtime to connect to the real database -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway: versioned SQL migrations, runs automatically on app startup -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Postgres-specific Flyway support (native enum types, etc.) -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Generates getters/setters/constructors via annotations, reduces entity/DTO boilerplate -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Auto-restarts the app on classpath changes during local development -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- ================= AUTH / SECURITY ================= -->

		<!-- Core Spring Security: filter chain, PasswordEncoder, authorizeHttpRequests -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- OAuth2 resource server support — used here for JWT decoding/validation
		     (NimbusJwtDecoder) on incoming Authorization: Bearer requests -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- Nimbus JOSE+JWT — used directly in JwtService to sign/generate tokens on
		     login/register. Version pinned manually since it's not covered by Spring's
		     managed versions — check periodically for CVEs (e.g. Sonatype OSS Index). -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
			<version>10.6</version>
		</dependency>

		<!-- ================= TEST — shared across unit / functional / integration ================= -->

		<!-- JUnit 5, Mockito, AssertJ, MockMvc, Spring TestContext framework -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- @WebMvcTest slice support (moved to its own module in Boot 4) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- @DataJpaTest slice support, in-test repository/entity assertions -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Validation-specific test support for slice tests exercising @Valid DTOs -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- SecurityMockMvcRequestPostProcessors — .with(jwt()...) etc. for functional
		     tests against secured endpoints without a real token -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- TestRestTemplate — moved to its own module in Boot 4, used in integration
		     tests to hit real HTTP endpoints (webEnvironment = RANDOM_PORT) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Runtime HTTP client support required by spring-boot-resttestclient
		     (not test-scoped: TestRestTemplateAutoConfiguration needs it on the
		     main classpath to initialize correctly) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Testcontainers JUnit 5 extension — @Testcontainers, @Container lifecycle management -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Spins up a real, throwaway Postgres instance in Docker for integration tests,
		     so tests run against the same DB engine as production rather than a
		     lighter-weight substitute like H2 -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Compiler config: wires Lombok's annotation processor into compilation -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- Surefire runs on `mvn test`: unit + functional tests (*Test.java).
			     Integration tests (*IT.java) are explicitly excluded so they don't
			     slow down the everyday test loop — they run separately via Failsafe. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*IT.java</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- Failsafe runs on `mvn verify`: integration tests (*IT.java), which need
			     Docker (via Testcontainers) and a full Spring context, so they're kept
			     out of the fast `mvn test` loop -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>